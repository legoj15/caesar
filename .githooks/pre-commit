#!/bin/sh
# Reject unqualified move()/forward() in staged src/ changes. Apple Clang is
# the only compiler that errors on these (-Wunqualified-std-cast-call under
# -Werror), so they sail through local MSVC/GCC builds and break exactly one
# CI job, minutes after the push. Bit twice on 2026-07-13/14.
bad=$(git diff --cached -U0 -- 'src/*.cpp' 'src/*.hpp' ':(exclude)src/libsmfc' ':(exclude)src/sf2cute' \
      | grep -E '^\+[^+]' | grep -nE '[^a-zA-Z_:.>](move|forward)\s*\(')
if [ -n "$bad" ]; then
    echo "pre-commit: unqualified move()/forward() in staged src changes" >&2
    echo "(breaks the macOS -Werror CI build; qualify as std::move / std::forward):" >&2
    echo "$bad" >&2
    exit 1
fi
exit 0
